# PostgreSQL credentials (use a strong unique password)
DB_USER=security
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=security_events
DB_PORT=5432
DB_BIND_ADDRESS=127.0.0.1

# vMaaS account values from its API Keys and Models pages
VMAAS_API_KEY=replace-with-your-vmaas-api-key
VMAAS_MODEL=replace-with-an-available-model-id
VMAAS_CHAT_COMPLETIONS_URL=https://aiplatform.viettelidc.com.vn/apis/v2/chat/completions
VMAAS_TIMEOUT_SECONDS=90

# Host path where BunkerWeb audit logs are mounted
BUNKERWEB_LOG_DIR=/var/log/bunkerweb
BUNKERWEB_LOG_GLOB=/var/log/bunkerweb/access.log
POLL_INTERVAL_SECONDS=3

# Dashboard exposure (0.0.0.0 exposes it on all host interfaces)
DASHBOARD_BIND_ADDRESS=0.0.0.0
